<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Trove starts on the menu bar. Its window spends most of its life
	     hidden and is summoned by a keystroke over whatever the user is
	     working in, so a Dock tile is off unless it is asked for in
	     Settings → Shortcut. This key is what stops a tile appearing during
	     launch, before any of our own code has run; the setting brings it
	     back at runtime for anyone who wants one, which the activation
	     policy allows even for an LSUIElement bundle. -->
	<key>LSUIElement</key>
	<true/>
	<!-- One Trove at a time, across user sessions too: with fast user
	     switching, a second session could otherwise start its own copy
	     while the first still watches the clipboard and holds the global
	     shortcut. Within one session this key does not stop `open -n`, a
	     second copy of the bundle, or the login item, which runs the binary
	     directly; the single-instance plugin and the instance lock are what
	     turn those away. -->
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<!-- The languages the interface is written in. Without this list macOS
	     treats the bundle as English-only: the web view then reports English
	     to the interface whatever the system language is, and the system's
	     own panels (open/save dialogs, alerts) stay English too. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>pl</string>
	</array>
</dict>
</plist>
