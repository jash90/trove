{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove",
  "version": "1.9.0",
  "identifier": "pl.local.trove",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop-ui dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop-ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trove",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "Settings — Trove",
        "url": "index.html#settings",
        "width": 840,
        "height": 820,
        "minWidth": 700,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true
      },
      {
        "label": "chat",
        "title": "Chat — Trove",
        "url": "index.html#chat",
        "width": 560,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzOURENTkxOTY4M0Y1RTcKUldUbjlZT1drZFdkTTBFV1FUVnlDZlBXTEMyeXBud3pkOWdwWk9DQkkvY08veHlmNnVhT2ZxZlgK",
      "endpoints": [
        "https://github.com/jash90/trove/releases/latest/download/latest.json"
      ]
    }
  }
}
