{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard History",
  "version": "0.1.0",
  "identifier": "pl.local.clipboard-history",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop-ui dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop-ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipboard History",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "capabilities": ["main-capability"] }
  },
  "bundle": { "active": true }
}
