{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard History",
  "version": "0.4.0",
  "identifier": "pl.local.clipboard-history",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop-ui dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop-ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipboard History",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true
      },
      {
        "label": "settings",
        "title": "Ustawienia — Clipboard History",
        "url": "index.html#settings",
        "width": 720,
        "height": 760,
        "minWidth": 560,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
